{$API_DOMAIN:api.trinusphere.com, api.trinusphere.com.br} {
    encode zstd gzip

    # Rotas do microsserviço iFood (credenciais, catálogo sync, status, disputas e imagens públicas)
    @ifood_service {
        path /api/v1/ifood/* /api/images/*
    }
    handle @ifood_service {
        reverse_proxy beebite-ifood:8081
    }

    # Todas as demais rotas vão para o backend principal BeeBite (Modo CLOUD)
    handle {
        reverse_proxy beebite-backend:8080
    }
}
