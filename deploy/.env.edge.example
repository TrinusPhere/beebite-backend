# ═══════════════════════════════════════════════════════════════════════════
# .env da Loja Local (Balcão Offline-First) — /opt/biteflow/.env
# ═══════════════════════════════════════════════════════════════════════════
EDGE_DB_PASSWORD=TroquePorUmaSenhaForteDoBancoLocal123
EDGE_INITIAL_ADMIN_PASSWORD=TroquePelaSenhaDoAdminDaLoja123

# Na 1ª implantação (apenas loja local, sem nuvem), mantenha STANDALONE:
BITEFLOW_SYNC_MODE=STANDALONE

# Na 2ª implantação (quando subir o Delivery na Nuvem), mude para EDGE e preencha:
# BITEFLOW_SYNC_MODE=EDGE
# CLOUD_SYNC_URL=https://api.seudominio.com.br
# EDGE_DEVICE_TOKEN=token_gerado_na_nuvem
