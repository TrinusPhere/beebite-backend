GCP_REGION=us-east1
GCP_PROJECT_ID=trinusphere-beebite-prd
APP_VERSION=latest

EDGE_DB_PASSWORD=TroquePorUmaSenhaForteDoBancoLocal2026!
EDGE_INITIAL_ADMIN_PASSWORD=TroquePelaSenhaDoAdminDaLoja2026!

# Sincronização automática Bancada -> Nuvem a cada 15s (Outbox)
BITEFLOW_SYNC_MODE=EDGE
CLOUD_SYNC_URL=https://api.trinusphere.com
EDGE_DEVICE_TOKEN=COLE_AQUI_O_TOKEN_GERADO_NO_PAINEL_TRINUSPHERE
