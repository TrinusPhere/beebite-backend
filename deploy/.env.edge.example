# ═══════════════════════════════════════════════════════════════════════════
# .env da Loja Local (Balcão Offline-First) — /opt/beebite-edge/.env
# ═══════════════════════════════════════════════════════════════════════════
GCP_REGION=us-east1
GCP_PROJECT_ID=trinusphere-beebite-prd
APP_VERSION=latest

EDGE_DB_PASSWORD=TroquePorUmaSenhaForteDoBancoLocal2026!
EDGE_INITIAL_ADMIN_PASSWORD=TroquePelaSenhaDoAdminDaLoja2026!

# Identificação da unidade (bootstrap automático: cria só a loja do cliente e remove o seed)
BEEBITE_EDGE_STORE_ID=COLE_AQUI_O_STORE_ID_GERADO_NA_NUVEM
BEEBITE_EDGE_STORE_NAME=Chefs Burguer - Balcão
BEEBITE_EDGE_STORE_SLUG=chefs-burguer-balcao
BEEBITE_EDGE_STORE_ADDRESS=Unidade Presencial / Balcão
BEEBITE_EDGE_ADMIN_LOGIN=admin

# Sincronização automática Bancada -> Nuvem a cada 15s (Outbox)
BEEBITE_SYNC_MODE=EDGE
CLOUD_SYNC_URL=https://api.trinusphere.com
EDGE_DEVICE_TOKEN=COLE_AQUI_O_TOKEN_GERADO_NO_PAINEL_TRINUSPHERE
