# =============================================================================
# .env de Produção — BiteFlow Cloud VM (/opt/biteflow/.env)
# Copie para /opt/biteflow/.env e restrinja com: chmod 600 /opt/biteflow/.env
# =============================================================================
GCP_PROJECT_ID=biteflow-prd
GCP_REGION=us-east1
APP_VERSION=latest

# Banco de Dados PostgreSQL (compartilhado entre os 2 databases: biteflow e biteflow_ifood)
DB_USER=postgres
DB_PASSWORD=COLE_AQUI_A_SENHA_GERADA_COM_OPENSSL_RAND_HEX_16

# Senha inicial obrigatória do usuário 'admin' em produção (ProductionAdminSeedGuard)
BITEFLOW_INITIAL_ADMIN_PASSWORD=COLE_AQUI_UMA_SENHA_FORTE_PARA_O_ADMIN

# Chave AES-256 de exatos 32 caracteres para criptografar tokens do iFood no banco
IFOOD_ENCRYPTION_KEY=COLE_AQUI_OS_32_CARACTERES_DO_OPENSSL_RAND_BASE64

# Domínios públicos configurados na Cloudflare
API_DOMAIN=api.seudominio.com.br
FRONTEND_ORIGIN=https://app.seudominio.com.br

